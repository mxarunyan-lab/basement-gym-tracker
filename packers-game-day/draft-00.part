<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#163d2a" />
  <title>The Packers Game Day Menu Draft</title>
  <style>
    :root{
      --green:#163d2a;
      --green-2:#245b3d;
      --gold:#f1c84b;
      --cream:#f8f1df;
      --paper:#fffaf0;
      --ink:#292820;
      --muted:#706b5f;
      --line:#d7cfbc;
      --white:#fff;
      --shadow:0 10px 28px rgba(22,61,42,.11);
      --radius:20px;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:var(--cream);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.58;font-size:16.5px}
    body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.24;background-image:radial-gradient(#163d2a .65px,transparent .65px);background-size:18px 18px;z-index:-1}
    button,input,textarea,select{font:inherit}
    button{-webkit-tap-highlight-color:transparent}
    .wrap{max-width:760px;margin:0 auto;padding:14px 12px 38px}
    .hero{background:var(--green);color:var(--white);border:3px solid var(--gold);border-radius:24px;padding:21px 18px 18px;box-shadow:var(--shadow);position:relative;overflow:hidden}
    .hero:after{content:"🏈";position:absolute;right:-8px;top:-24px;font-size:108px;opacity:.1;transform:rotate(-18deg)}
    .kicker{font-size:.77rem;font-weight:600;text-transform:uppercase;letter-spacing:.16em;color:var(--gold)}
    h1,h2{font-family:Georgia,"Times New Roman",serif;font-weight:500}
    h1{font-size:clamp(2rem,8vw,3.45rem);line-height:.98;margin:.42rem 0 .62rem;letter-spacing:-.025em}
    .hero p{margin:.35rem 0 0;max-width:620px;color:#f6efd9;font-size:1rem}
    .name-row{margin-top:16px;display:flex;gap:9px;flex-wrap:wrap;align-items:center;position:relative;z-index:1}
    .name-row label{font-weight:600;color:var(--gold)}
    select{flex:1;min-width:190px;border:1.5px solid #d5c68e;background:#fffdf7;padding:12px 38px 12px 13px;border-radius:12px;font-size:1rem;outline:none;color:var(--ink);appearance:none;background-image:linear-gradient(45deg,transparent 50%,var(--green) 50%),linear-gradient(135deg,var(--green) 50%,transparent 50%);background-position:calc(100% - 17px) 52%,calc(100% - 12px) 52%;background-size:5px 5px,5px 5px;background-repeat:no-repeat}
    select:focus,textarea:focus{border-color:var(--green-2);box-shadow:0 0 0 3px rgba(36,91,61,.13)}
    select.invalid{border-color:#a54b4b;box-shadow:0 0 0 3px rgba(165,75,75,.13)}
    .name-error{display:none;width:100%;margin-top:-2px;color:#ffe5e0;font-size:.82rem}
    .name-error.show{display:block}

    .progress-card{margin:14px 0;background:var(--paper);border:1.5px solid var(--line);border-radius:18px;padding:12px 13px;box-shadow:var(--shadow)}
    .progress-top{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:9px;color:var(--muted);font-size:.9rem}
    .progress-title{color:var(--green);font-weight:600;letter-spacing:.025em}
    .progress-track{height:7px;border-radius:999px;background:#e6dfcf;overflow:hidden}
    .progress-fill{height:100%;width:0;background:var(--green-2);transition:width .2s ease}
    .stage-dots{display:flex;gap:5px;margin-top:9px;overflow:auto;padding-bottom:2px}
    .stage-dot{flex:1;min-width:28px;height:8px;border:0;border-radius:999px;background:#ddd5c3;cursor:pointer;padding:0}.stage-dot:disabled{cursor:not-allowed;opacity:.42}
    .stage-dot.done{background:#b9a653}.stage-dot.active{background:var(--green)}

    .panel{display:none;background:var(--paper);border:1.5px solid var(--line);border-radius:22px;padding:16px;box-shadow:var(--shadow)}
    .panel.active{display:block}
    .welcome h2,.round h2,.summary h2{margin:0 0 8px;color:var(--green);font-size:1.55rem}
    .welcome p{margin:.45rem 0;color:#4e4a42}
    .rules-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin-top:14px}
    .rule{background:#fff;border:1px solid var(--line);padding:11px;border-radius:13px}
    .rule-title{display:flex;align-items:center;gap:7px;color:var(--green);font-weight:600;margin-bottom:3px}
    .mini{font-size:.88rem;color:var(--muted)}
    .tip{margin-top:13px;padding:10px 11px;border-radius:12px;background:#f3ecd8;color:#5f5848;font-size:.88rem}

    .round-head{margin-bottom:13px}
    .round-tag{display:inline-block;font-size:.71rem;background:var(--gold);color:var(--green);padding:5px 9px;border-radius:999px;font-weight:600;text-transform:uppercase;letter-spacing:.07em;margin-bottom:7px}
    .round-sub{margin:0;color:var(--muted);font-size:1rem}
    .food{background:#fff;border:1.5px solid var(--line);border-radius:16px;padding:13px;margin:10px 0;transition:.15s ease}
    .food.franchise{border-color:#c7a52d;box-shadow:0 0 0 3px rgba(241,200,75,.22)}
    .food h3{margin:0;color:var(--green);font-size:1.05rem;font-weight:600;line-height:1.35}
    .food p{margin:7px 0 12px;color:#504d45;font-size:.98rem;line-height:1.56}
    .ratings{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
    .rating{border:1.5px solid var(--line);background:#fbf8ef;border-radius:11px;padding:9px 5px;font-size:.74rem;font-weight:500;cursor:pointer;text-align:center;color:#4c493f;min-height:64px;touch-action:manipulation}
    .rating span{display:block;font-size:1.08rem;margin-bottom:2px}
    .rating.active{color:var(--ink);box-shadow:inset 0 0 0 1px rgba(0,0,0,.04)}
    .rating[data-value="first"].active{background:#f4dddd;border-color:#a54b4b;color:#6f2020}
    .rating[data-value="roster"].active{background:#dfeade;border-color:var(--green-2);color:var(--green)}
    .rating[data-value="bench"].active{background:#e8e2d5;border-color:#8b826d;color:#4d483d}
    .rating[data-value="cut"].active{background:#e4e2dd;border-color:#5b5951;color:#292820}
    .franchise-btn{margin-top:9px;width:100%;border:1.5px dashed #b6952a;background:#fff9df;color:#5a4700;border-radius:11px;padding:11px;font-weight:600;cursor:pointer;touch-action:manipulation}.franchise-badge{margin-top:8px;border-radius:10px;padding:8px 10px;background:#f8ecc0;color:#604b00;text-align:center;font-size:.82rem;font-weight:600;letter-spacing:.035em}
    .franchise-btn.active{background:var(--gold);border-style:solid;color:var(--green)}
    .franchise-badge{display:inline-flex;align-items:center;gap:6px;margin:2px 0 8px;padding:5px 9px;border-radius:999px;background:#fff8d2;border:1px solid #d9bd4f;color:#5a4700;font-size:.76rem;font-weight:600}
    .stage-meta{margin:0 0 7px;color:var(--green);font-size:.8rem;letter-spacing:.08em;text-transform:uppercase}
    .round-note{margin-top:10px;color:#7a4a12;background:#fff4d8;border:1px solid #e3c884;border-radius:11px;padding:9px 10px;font-size:.88rem}
    .next[disabled]{background:#9cad9f;color:#f6f6f1;cursor:not-allowed;opacity:1}
    .summary-rounds{display:grid;gap:10px;margin:12px 0 14px}
    .summary-round{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;background:#fff;border:1px solid var(--line);border-radius:14px;padding:12px}
    .summary-round h3{margin:0 0 4px;color:var(--green);font-size:1rem;font-weight:600}
    .summary-round p{margin:0;color:#514d44;font-size:.93rem;line-height:1.45}
    .edit-round{flex:0 0 auto;border:1px solid var(--line);background:#fff;color:var(--green);border-radius:10px;padding:8px 10px;cursor:pointer;font-weight:600}
    .audible{margin-top:15px;border-top:1px dashed var(--line);padding-top:12px}
    .audible label{display:block;font-weight:600;color:var(--green);margin-bottom:5px}
    .audible .mini{display:block;margin-bottom:7px}
    textarea{width:100%;min-height:74px;resize:vertical;border:1.5px solid var(--line);border-radius:12px;background:#fff;padding:10px;outline:none}
    .round-tools{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:13px;padding:10px 11px;border:1px solid var(--line);border-radius:13px;background:#f7f1e2}
    .round-tools-copy{min-width:0}
    .round-tools-title{display:block;color:var(--green);font-size:.78rem;font-weight:600;text-transform:uppercase;letter-spacing:.055em;margin-bottom:2px}
    .clear-round{flex:0 0 auto;border:1px solid #c9bfa9;background:#fff;color:#5e5749;border-radius:10px;padding:8px 10px;cursor:pointer;font-size:.78rem;font-weight:500}
    .clear-round.armed{border-color:#a54b4b;background:#f8e7e3;color:#7b2929}

    .nav{display:flex;gap:8px;margin-top:14px}
    .nav button{flex:1;border:0;border-radius:13px;padding:13px 13px;cursor:pointer;font-weight:600;min-height:49px}.nav button:disabled{cursor:not-allowed;opacity:.45;filter:grayscale(.18)}
    .next{background:var(--green);color:#fff}.back{background:#fff;color:var(--green);border:1px solid var(--line)!important}.gold{background:var(--gold);color:var(--green)}
    .summary-text{white-space:pre-wrap;background:#fff;border:1px solid var(--line);border-radius:14px;padding:13px;font-size:.93rem;line-height:1.58}.summary-grid{display:grid;gap:9px;margin:14px 0}.summary-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:12px}.summary-card-top{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}.summary-card h3{margin:0;color:var(--green);font-size:1rem;font-weight:600}.summary-pick{margin-top:5px;color:#4e4a42;font-size:.94rem}.edit-round{flex:0 0 auto;border:1px solid var(--line);background:#fffaf0;color:var(--green);border-radius:9px;padding:7px 9px;font-size:.8rem;font-weight:600;cursor:pointer}.copy-preview{margin-top:12px}.copy-preview summary{cursor:pointer;color:var(--green);font-weight:600}.next-help{margin-top:8px;text-align:center;color:#7a5a00;background:#fff5ce;border:1px solid #e3ce73;border-radius:10px;padding:8px 10px;font-size:.84rem}.save-note{margin-top:6px;color:#55745f;font-size:.84rem}.reset-confirm{margin-top:10px;padding:10px;border:1px solid #d5b8ad;background:#fbede9;border-radius:11px;color:#6d3c33;font-size:.88rem}.reset-confirm .reset-actions{display:flex;gap:8px;margin-top:8px}.reset-confirm button{flex:1;border-radius:9px;padding:8px;border:1px solid #c7afa6;background:#fff;cursor:pointer}.reset-confirm .danger{background:#7b2929;color:#fff;border-color:#7b2929}
    .summary-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
    .summary-actions button{flex:1;min-width:145px;border:0;border-radius:12px;padding:11px 12px;cursor:pointer;font-weight:600}
    .recipe-link-row{text-align:center;margin-top:12px}.recipe-link{display:inline-flex;align-items:center;justify-content:center;gap:7px;text-decoration:none;border:1.5px solid var(--line);background:#fffaf0;color:var(--green);border-radius:12px;padding:10px 13px;font-weight:600;font-size:.92rem}.recipe-link:hover{border-color:#b7aa8c;background:#fffdf7}
    .text-draft{background:var(--green);color:#fff}.copy{background:#fff;color:var(--green);border:1px solid var(--line)!important}.reset{background:#fff;color:var(--green);border:1px solid var(--line)!important}
    .footer{text-align:center;color:var(--muted);font-size:.83rem;margin-top:18px}

    @media(max-width:600px){
      .wrap{padding-left:9px;padding-right:9px}.hero,.panel,.progress-card{border-radius:17px}.rules-grid{grid-template-columns:1fr}.ratings{grid-template-columns:repeat(2,1fr)}.rating{font-size:.76rem}.nav{position:sticky;bottom:7px;padding:8px;background:rgba(248,241,223,.94);backdrop-filter:blur(5px);border-radius:15px;margin-left:-5px;margin-right:-5px}.stage-dots{gap:4px}.round-tools{align-items:flex-start;flex-direction:column}.clear-round{width:100%}
    }
  </style>
</head>
<body>
<div class="wrap">
  <header class="hero">
    <div class="kicker">Friday, Aug. 28 • Preseason at Lambeau</div>
    <h1>The Packers Game Day<br>Menu Draft</h1>
    <p>Scout the food, build your board, and help draft the menu for game day.</p>
    <div class="name-row">
      <label for="voterName">Your name</label>
      <select id="voterName" aria-describedby="nameError">
        <option value="">Choose your name…</option>
        <option value="Archie">Archie</option>
        <option value="Brooke">Brooke</option>
        <option value="Tracy">Tracy</option>
      </select>
      <span class="name-error" id="nameError">Pick your name before starting the draft.</span>
    </div>
  </header>

  <section class="progress-card" aria-label="Draft progress">
    <div class="progress-top"><span class="progress-title" id="progressTitle">How It Works</span><span id="progressCount">Start</span></div>
    <div class="progress-track"><div class="progress-fill" id="progressFill"></div></div>
    <div class="stage-dots" id="stageDots"></div>
    <div class="mini" id="progressNotice" aria-live="polite" style="margin-top:7px"></div>
  </section>

  <main id="app"></main>
  <div class="footer">Your picks save automatically on this device.</div>
</div>

<script>
const rounds = [
  {
    id:'pregame', label:'Pregame', tag:'Warm-Up',
    subtitle:'Start with one small appetizer — something fun enough to feel like game day, but not so heavy that it steals the main event.',
    items:[
      ['old-fashioned-meatballs','Brandy Old-Fashioned Glazed Meatballs','Tender baked or smoked cocktail meatballs coated in a glossy brandy glaze with brown sugar, bitters, Worcestershire and warm savory seasoning. Sweet-savory, very Wisconsin supper-club, and easy to grab with a toothpick.'],
      ['hot-beef-sundaes','Mini Wisconsin Hot Beef Sundaes','Small cups of buttery mashed potatoes topped with tender beef, rich brown gravy, sharp cheddar and crispy onions. The name is playful; the food is basically a two-bite Wisconsin comfort-food dinner.'],
      ['buffalo-pinwheels','Smoked Buffalo Chicken Pinwheels','Smoky shredded chicken tossed with buffalo sauce, cheddar and scallions, rolled into flaky puff pastry and baked into crisp spirals. Ranch on the side for dipping — all the buffalo-wing energy without frying.'],
      ['loaded-potato-cups','Mini Loaded Potato Cups','Roasted baby potato halves crisped in the oven, then filled with bacon, sharp cheddar, sour cream and scallions. A loaded baked potato condensed into a warm two-bite appetizer.'],
      ['bloody-mary-steak','Bloody Mary Steak Bites','Seared steak bites seasoned with Worcestershire, celery salt and black pepper, with a creamy horseradish sauce for dipping. Bloody-Mary-bar flavors without turning the steak into a tomato-flavored gimmick.']
    ]
  },
  {
    id:'main', label:'Main Event', tag:'Kickoff',
    subtitle:'The centerpiece of the meal — the dish that should feel special enough to brag about after the weekend.',
    items:[
      ['supper-club-chicken','Wisconsin Supper Club Chicken','Juicy chicken finished with bacon, sautéed mushrooms and melted Swiss, then served with a creamy peppercorn-Dijon pan sauce. Rich and supper-club-ish without being fussy.'],
      ['pork-roulade','Smoked Pork Tenderloin Roulade','Pork tenderloin butterflied and rolled around bacon, sharp cheddar, caramelized onions and herbs, then smoked and sliced into spirals. It has real “you made that?” payoff when it hits the table.'],
      ['tavern-meatloaf','Wisconsin Tavern Meatloaf','A smoky beef-and-pork meatloaf built with bacon, onion, Worcestershire and mustard, sliced thick and served with a rich beer-onion brown gravy. Familiar Wisconsin comfort food, just turned way up.'],
      ['supper-club-pork','Supper Club Pork Chops','Thick-cut pork chops smoked or seared until juicy, then finished with a creamy brandy-Dijon peppercorn sauce. More classic supper-club dinner than tailgate food, in a good way.'],
      ['flank-pinwheels','Smoked Stuffed Flank Steak Pinwheels','Flank steak rolled around bacon, sharp cheddar and caramelized onions, then smoked, seared and sliced into big spirals. Smoky, beefy and probably the most dramatic-looking option on the board.'],
      ['bourbon-pork','Smoked Bourbon-BBQ Pork Chops with Bacon-Onion Jam','Thick pork chops smoked and seared, brushed with a sticky bourbon-BBQ glaze, then topped with savory bacon-onion jam. The most game-day-smokehouse option without turning dinner into standard barbecue.']
    ]
  },
  {
    id:'halftime', label:'Halftime', tag:'Sides',
    subtitle:'These are the sides that would share the plate with the Main Event. More than one can make the final menu.',
    items:[
      ['loaded-potato-salad','Loaded Bacon-Cheddar Potato Salad','Chunky potatoes with bacon, sharp cheddar, hard-boiled egg and scallions in a creamy sour-cream-and-mustard dressing. Loaded-baked-potato flavors, served cold and easy to make ahead.'],
      ['supper-club-potato-salad','Wisconsin Supper Club Potato Salad','A more classic savory potato salad with red potatoes, hard-boiled egg, onion, celery, mustard and paprika in a creamy dressing. Old-school Wisconsin picnic and supper-club energy, with no pickles.'],
      ['twice-baked','Supper Club Twice-Baked Potatoes','Baked potatoes scooped and whipped with butter, sour cream, sharp cheddar, bacon and scallions, then filled back up and baked until browned and bubbling. A richer, hot side for a true comfort-food plate.'],
      ['italian-pasta','Wisconsin Italian Pasta Salad','Rotini tossed with salami, pepperoni, mozzarella, cheddar, red onion and pepperoncini in a punchy Italian dressing. Cold, salty and tangy enough to balance one of the richer mains.'],
      ['tavern-pizza','Smoked Wisconsin Tavern Pizza Squares','A thin, crispy bar-style pizza cooked on the smoker with sausage, pepperoni, onion, mozzarella and a little sharp cheddar, then cut into small tavern squares. It can work as a playful side or as its own game-day snack later.']
    ]
  },
  {
    id:'third', label:'3rd Quarter', tag:'Game-Day Snack',
    subtitle:'A bonus salty snack for the game-day spread — something easy to grab while everyone is getting ready to head to Lambeau.',
    items:[
      ['third-pizza','Smoked Tavern Pizza Squares','Thin, crisp 