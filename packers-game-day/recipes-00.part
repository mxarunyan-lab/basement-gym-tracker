<style>
:root{--green:#164b35;--gold:#d4aa2d;--cream:#f6f0df;--paper:#fffaf1;--ink:#302d27;--muted:#746b5d;--line:#d7cdb8;--rust:#8d4d33;--soft:#eee5d2;--shadow:0 3px 12px rgba(48,40,25,.06)}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--ink);font-family:Arial,Helvetica,sans-serif;line-height:1.6;font-size:17px}button,input,a{font:inherit}.hero{background:var(--green);color:white;border-bottom:7px solid var(--gold);padding:34px 18px 29px}.hero-inner{max-width:1020px;margin:auto;text-align:center}.kicker{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:#f4d96a;margin-bottom:7px}.hero h1{font-family:Georgia,serif;font-size:clamp(35px,7vw,58px);font-weight:500;line-height:1.05;margin:0}.hero p{max-width:670px;margin:12px auto 0;color:#f6edda}.shell{max-width:1020px;margin:auto;padding:18px 14px 55px}.toolbar{position:sticky;top:0;z-index:5;padding:10px 0 12px;background:linear-gradient(var(--cream) 78%,rgba(246,240,223,0));display:grid;grid-template-columns:1fr auto;gap:9px}.search{width:100%;border:1px solid var(--line);border-radius:14px;background:#fffdf7;padding:14px 15px;color:var(--ink);box-shadow:0 2px 8px rgba(42,37,26,.05)}.search:focus{outline:3px solid rgba(212,170,45,.3);border-color:var(--gold)}.share-book{border:1px solid var(--line);border-radius:14px;background:var(--paper);color:var(--green);padding:12px 14px;white-space:nowrap;cursor:pointer}.intro{text-align:center;margin:7px auto 16px;color:var(--muted);max-width:720px}.round-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:17px 0 30px}.round-card{display:block;text-decoration:none;color:var(--ink);background:var(--paper);border:1px solid var(--line);border-radius:17px;padding:17px;box-shadow:var(--shadow);min-height:136px}.round-card:hover,.round-card:focus{border-color:var(--gold);outline:3px solid rgba(212,170,45,.15)}.round-num{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--rust)}.round-name{display:block;font-family:Georgia,serif;font-size:25px;font-weight:500;color:var(--green);line-height:1.1;margin:3px 0}.round-purpose{font-size:14px;color:var(--muted)}.round-count{display:inline-block;margin-top:9px;border-radius:999px;padding:4px 8px;background:#e9eee2;color:var(--green);font-size:12px}.section{scroll-margin-top:88px;margin:35px 0 44px}.section-head{display:flex;align-items:end;justify-content:space-between;gap:12px;border-bottom:3px solid var(--gold);padding-bottom:9px;margin-bottom:13px}.section-head h2{font-family:Georgia,serif;font-weight:500;color:var(--green);font-size:31px;line-height:1.1;margin:0}.section-head p{font-size:14px;color:var(--muted);margin:3px 0 0}.top-link{font-size:13px;color:var(--green);white-space:nowrap}.recipe-list{display:grid;gap:11px}.recipe{background:var(--paper);border:1px solid var(--line);border-radius:17px;box-shadow:var(--shadow);overflow:hidden;scroll-margin-top:90px}.recipe[open]{border-color:#c0ab7b}.recipe summary{list-style:none;padding:17px 18px;display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center;cursor:pointer}.recipe summary::-webkit-details-marker{display:none}.r-title{font-family:Georgia,serif;font-size:22px;font-weight:500;color:var(--green);line-height:1.2}.r-mini{display:flex;flex-wrap:wrap;gap:6px;margin-top:7px}.pill{font-size:12px;padding:4px 8px;border-radius:999px;background:var(--soft);color:#554e42}.open-label{font-size:13px;color:var(--green);white-space:nowrap}.recipe[open] .open-label::before{content:'Close recipe';font-size:13px}.recipe[open] .open-label{font-size:0}.recipe-body{border-top:1px solid var(--line);padding:17px 18px 21px}.meta-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.meta-card{background:#f0e7d5;border-radius:11px;padding:9px 10px;font-size:14px}.meta-card span{display:block;font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:2px}.makeahead,.note{border-radius:10px;padding:11px 12px;margin:12px 0;font-size:15px}.makeahead{background:#eaf0e4;border-left:4px solid var(--green)}.note{background:#f6e8bf;border-left:4px solid var(--gold)}.cols{display:grid;grid-template-columns:.85fr 1.3fr;gap:22px}.sub{font-family:Georgia,serif;font-size:20px;font-weight:500;color:var(--rust);margin:12px 0 6px}ul,ol{padding-left:23px;margin-top:5px}li{margin:7px 0}.actions{display:flex;gap:8px;flex-wrap:wrap;border-top:1px solid var(--line);padding-top:14px;margin-top:16px}.actions button{border:1px solid var(--line);background:#fffdf7;color:var(--green);border-radius:11px;padding:10px 13px;cursor:pointer}.actions .share{background:var(--green);color:white;border-color:var(--green)}.status{font-size:13px;color:var(--green);align-self:center}.search-empty{display:none;background:var(--paper);border:1px dashed var(--line);border-radius:16px;padding:24px;text-align:center;color:var(--muted);margin:15px 0}.hidden-search{display:none!important}footer{text-align:center;color:var(--muted);font-size:13px;padding:0 15px 40px}
@media(max-width:760px){body{font-size:16px}.toolbar{grid-template-columns:1fr}.share-book{width:100%}.round-grid{grid-template-columns:1fr 1fr}.cols{grid-template-columns:1fr}.hero{padding-top:29px}.section-head{align-items:start}.meta-grid{grid-template-columns:1fr 1fr}}
@media(max-width:470px){.round-grid{grid-template-columns:1fr}.round-card{min-height:auto}.recipe summary{padding:15px}.recipe-body{padding:15px}.section-head h2{font-size:27px}}
@media print{.toolbar,.round-grid,.intro,.actions,.top-link{display:none!important}body{background:white}.hero{background:white;color:black;border-bottom:2px solid black}.hero p,.kicker{color:black}.recipe{box-shadow:none;break-inside:avoid}.recipe-body{display:block!important}}
</style>
</head>
